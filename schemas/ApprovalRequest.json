{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A request for human approval of a high-risk operation.",
  "properties": {
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "work_order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Work Order Id",
      "type": "string"
    },
    "agent": {
      "title": "Agent",
      "type": "string"
    },
    "tool_name": {
      "title": "Tool Name",
      "type": "string"
    },
    "tool_args": {
      "additionalProperties": true,
      "title": "Tool Args",
      "type": "object"
    },
    "reason": {
      "description": "Why this operation needs approval",
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "risk_factors": {
      "items": {
        "type": "string"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "pending"
    },
    "requested_at": {
      "default": "",
      "title": "Requested At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided By"
    },
    "decision_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Reason"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    }
  },
  "required": [
    "id",
    "task_id",
    "work_order_id",
    "agent",
    "tool_name",
    "reason"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}

          "default": null,
          "title": "Line"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "failure_scenario": {
          "default": "",

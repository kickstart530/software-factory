{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "verification": {
          "default": "gate",
          "enum": [
            "gate",
            "review",
            "human"
          ],
          "title": "Verification",
          "type": "string"
        },
        "gate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Gate name when verification == 'gate'.",
          "title": "Gate"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "AcceptanceCriterion",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Hard caps for one task or Work Order. ``None`` means uncapped.",
      "properties": {
        "tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens"
        },
        "usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usd"
        },
        "wall_clock_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Clock S"
        },
        "turns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        },
        "tool_calls": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Calls"
        },
        "soft_limit_ratio": {
          "default": 0.8,
          "description": "Fraction of a cap at which the agent is warned.",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Soft Limit Ratio",
          "type": "number"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "description": "One independently verifiable step, executed by one agent in one sandbox.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Id",
          "type": "string"
        },
        "work_order_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$",
          "title": "Work Order Id",
          "type": "string"
        },
        "agent": {
          "description": "Agent definition name, e.g. 'implementer'.",
          "title": "Agent",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "instructions": {
          "title": "Instructions",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "depends_on": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Overrides the agent's default budget when set."
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Branch"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus",
          "default": "pending"
        }
      },
      "required": [
        "id",
        "work_order_id",
        "agent",
        "title",
        "instructions"
      ],
      "title": "Task",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "escalated",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "work_order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Work Order Id",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/Task"
      },
      "minItems": 1,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "work_order_id",
    "tasks"
  ],
  "title": "TaskDAG",
  "type": "object"
}

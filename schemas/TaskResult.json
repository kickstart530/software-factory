{
  "$defs": {
    "Escalation": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "question"
      ],
      "title": "Escalation",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "output_tail": {
          "default": "",
          "title": "Output Tail",
          "type": "string"
        },
        "duration_s": {
          "default": 0.0,
          "title": "Duration S",
          "type": "number"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "escalated",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cache_write_tokens": {
          "default": 0,
          "title": "Cache Write Tokens",
          "type": "integer"
        },
        "usd": {
          "default": 0.0,
          "title": "Usd",
          "type": "number"
        },
        "turns": {
          "default": 0,
          "title": "Turns",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "wall_clock_s": {
          "default": 0.0,
          "title": "Wall Clock S",
          "type": "number"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the harness reports back to the orchestrator for every task run.",
  "properties": {
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "title": "Task Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "summary": {
      "default": "",
      "title": "Summary",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Agent output, validated against the agent's output schema.",
      "title": "Output"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    },
    "escalation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Escalation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "checkpoint_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Id"
    }
  },
  "required": [
    "task_id",
    "status"
  ],
  "title": "TaskResult",
  "type": "object"
}

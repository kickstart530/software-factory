# Example backend configuration for Terraform state
# Copy this file to backend.tf and customize for your setup

# terraform {
#   backend "s3" {
#     bucket         = "my-terraform-state-bucket"
#     key            = "software-factory/terraform.tfstate"
#     region         = "us-east-1"
#     dynamodb_table = "terraform-state-lock"
#     encrypt        = true
#   }
# }

# To create the required resources:
# 1. S3 bucket for state:
#    aws s3 mb s3://my-terraform-state-bucket
#    aws s3api put-bucket-versioning --bucket my-terraform-state-bucket --versioning-configuration Status=Enabled
#
# 2. DynamoDB table for locking:
#    aws dynamodb create-table \
#      --table-name terraform-state-lock \
#      --attribute-definitions AttributeName=LockID,AttributeType=S \
#      --key-schema AttributeName=LockID,KeyType=HASH \
#      --billing-mode PAY_PER_REQUEST

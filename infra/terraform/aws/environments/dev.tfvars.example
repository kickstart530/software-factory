# Example variables for development environment
# Copy to dev.tfvars and customize

project_name = "software-factory"
environment  = "dev"
region       = "us-east-1"

# EKS Configuration
eks_cluster_version = "1.28"

# System nodes (always-on)
system_node_instance_types = ["t3.medium"]
system_node_desired_size   = 2
system_node_min_size       = 2
system_node_max_size       = 4

# Sandbox nodes (autoscaled, spot)
sandbox_node_instance_types = ["t3.medium", "t3a.medium"]
sandbox_node_desired_size   = 1
sandbox_node_min_size       = 0
sandbox_node_max_size       = 10
use_spot_instances          = true

# gVisor (requires custom AMI)
enable_gvisor = false

# PostgreSQL
postgres_instance_class        = "db.t3.micro"
postgres_allocated_storage     = 20
postgres_backup_retention_days = 7

# Additional tags
tags = {
  Owner = "platform-team"
  CostCenter = "engineering"
}
